# ConvertLab — TLS terminator.
#
#   :80            permanent redirect to the canonical HTTPS site
#   fileshop.shop  HTTPS with an automatically managed certificate
#
# There is deliberately no HTTPS listener for the bare IP: a public CA cannot
# issue a certificate for 111.91.29.56. Use https://fileshop.shop.
#
# Every block proxies to the application, which only listens on 127.0.0.1:8080.
{
	# Caddy's own logs; rotate by size so a long-running box cannot fill the disk.
	log {
		output file /var/log/caddy/caddy.log {
			roll_size 20MiB
			roll_keep 5
		}
		level INFO
	}
}

(convertlab) {
	encode zstd gzip
	# Streams the multipart upload straight through and keeps server-sent
	# events (job progress) unbuffered.
	request_body {
		max_size 250MB
	}
	reverse_proxy 127.0.0.1:8080 {
		flush_interval -1
		transport http {
			read_timeout 15m
			write_timeout 15m
		}
	}
}

:80 {
	redir https://fileshop.shop{uri} permanent
}

https://fileshop.shop {
	import convertlab
}
