# ---- Server ----
NODE_ENV=production
HOST=0.0.0.0
PORT=8080
APP_BASE_URL=http://localhost:8080
# Host port mapping for Compose. Bind to the loopback address when a reverse
# proxy (Caddy / Nginx) is in front, so the app cannot be reached directly.
HOST_PORT=8080
TRUST_PROXY=true
# all = web + embedded worker; web = API only; worker = queue consumer only
PROCESS_ROLE=all
SECURE_COOKIES=false
COOKIE_SECRET=replace-with-a-long-random-string

# ---- Storage (shared volume in Compose) ----
# Outside Docker, use a local path such as ./data and ./dist/web.
DATA_DIR=/data
PUBLIC_DIR=/app/dist/web

# ---- Accounts ----
# Created on first boot when the users table is empty. Change the password after first login.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please-8chars
SESSION_TTL_DAYS=30
ALLOW_REGISTRATION=true

# ---- Limits ----
FILE_TTL_HOURS=2
MAX_FILE_MB=100
MAX_BATCH_FILES=20
DAILY_JOBS=20
DAILY_UPLOAD_MB=1024
DAILY_OUTPUT_MB=2048

# ---- Persistence and queue ----
# Shared secret for the bundled PostgreSQL container. Compose builds
# DATABASE_URL from this value, so changing it here is enough.
POSTGRES_PASSWORD=change-me-please-long-random
# For docker compose only. Set DATABASE_URL when running the app outside
# Compose, or override DATABASE_URL in a docker-compose.override.yml file to
# point at an external PostgreSQL instance.
# DATABASE_URL=postgresql://convertlab:change-me-please-long-random@localhost:5432/convertlab
# Managed PostgreSQL (Supabase, Neon, RDS): keep ?sslmode=require in the URL,
# or set DATABASE_SSL=true when the URL has no sslmode parameter.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# DATABASE_SSL=false
DATABASE_POOL_SIZE=10
# Outside Docker, use redis://127.0.0.1:6379.
REDIS_URL=redis://redis:6379
QUEUE_NAME=convertlab

# ---- Worker ----
WORKER_CONCURRENCY=3
JOB_TIMEOUT_SEC=600
SOFFICE_PATH=soffice
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
GS_PATH=gs
PDFTOPPM_PATH=pdftoppm
PDFTOTEXT_PATH=pdftotext
PDFTOCAIRO_PATH=pdftocairo
PDFINFO_PATH=pdfinfo
# Isolated Python interpreter used by pdfplumber and RapidTable.
PYTHON_TABLE_BIN=/opt/convertlab-python/bin/python
